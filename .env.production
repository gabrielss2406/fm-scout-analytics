# Production Environment Variables for FM Moneyball Scout

# Application
NODE_ENV=production
VITE_APP_NAME="FM Moneyball Scout"
VITE_APP_VERSION="1.0.0"

# API Configuration (uncomment and configure when adding backend)
# VITE_API_URL=https://api.your-domain.com
# VITE_API_TIMEOUT=10000

# Analytics (uncomment if using analytics)
# VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
# VITE_HOTJAR_ID=XXXXXXX

# Feature Flags
VITE_ENABLE_DEBUG=false
VITE_ENABLE_ANALYTICS=true

# CDN/Assets (if using external CDN)
# VITE_CDN_URL=https://cdn.your-domain.com

# Security
VITE_CSP_REPORT_URI=/csp-report